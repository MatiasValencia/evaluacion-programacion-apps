rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function hasRole(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return request.auth != null
        && (
          request.auth.uid == 'S50r4CXrkMXxaiP7schIno93LvO2'
          || hasRole('admin')
        );
    }

    function isCommonUser() {
      return request.auth != null
        && (
          request.auth.uid == 'rWwzcfpIHiSsqn9pwW7iUKK7zxW2'
          || hasRole('readOnly')
        );
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['firstName', 'lastName', 'email'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow write: if false;
    }

    match /students/{documentId} {
      allow read: if isAdmin() || isCommonUser();
      allow write: if isAdmin();
    }

    match /assignments/{documentId} {
      allow read: if isAdmin() || isCommonUser();
      allow write: if isAdmin();
    }

    match /attendanceRecords/{documentId} {
      allow read: if isAdmin() || isCommonUser();
      allow write: if isAdmin();
    }

    match /evaluationGrades/{documentId} {
      allow read: if isAdmin() || isCommonUser();
      allow write: if isAdmin();
    }

    match /pedagogicalSkills/{documentId} {
      allow read: if isAdmin() || isCommonUser();
      allow write: if isAdmin();
    }

    match /metadata/{documentId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}